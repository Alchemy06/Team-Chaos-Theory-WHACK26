# ── Node environment ─────────────────────────────────────
FROM node:22-bookworm-slim

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# ── Install dependencies ──────────────────────────────────
COPY package.json package-lock.json ./
RUN npm ci

# ── Copy application ─────────────────────────────────────
COPY . .

# ── Start development server ─────────────────────────────
EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]