# Server-side AI and database configuration. Use your team project values in .env.local.
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional media integrations
# Films: themoviedb.org -> Settings -> API -> request a free Developer key, then copy the
# "API Read Access Token" (the long v4 token, not the short v3 "API Key").
TMDB_TOKEN=
# Games: rawg.io/apidocs -> "Get API key" (free tier, 20k requests a month).
RAWG_KEY=

ELEVENLABS_API_KEY=

ELEVENLABS_VOICE_ID=
